<Window x:Class="NoFocusLossGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NoFocusLossGUI"
        Title="NoFocusLoss" Width="960" Height="650" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" Icon="Resources/app.ico" Loaded="WindowLoaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Presentation/Design.xaml" /></ResourceDictionary.MergedDictionaries>
            <local:ProcessLabelConverter x:Key="ProcessLabel" />
            <DataTemplate x:Key="ProcessRow">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource RaisedBrush}" VerticalAlignment="Center">
                        <Path Data="M 1,1 L 13,1 L 13,11 L 1,11 Z M 1,4 L 13,4" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.2" Width="14" Height="12" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Converter={StaticResource ProcessLabel}, ConverterParameter=title}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Converter={StaticResource ProcessLabel}, ConverterParameter=title}" />
                        <TextBlock Text="{Binding Converter={StaticResource ProcessLabel}, ConverterParameter=detail}" Style="{StaticResource MutedText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="NoFocusLoss" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="{x:Static local:UiStrings.AppSubtitle}" Style="{StaticResource MutedText}" Margin="0,6,0,0" /></StackPanel>
            <Button Grid.Column="1" Content="◐" ToolTip="{x:Static local:UiStrings.ThemeTooltip}" AutomationProperties.Name="{x:Static local:UiStrings.ThemeTooltip}" Click="ToggleTheme" Width="38" Padding="0" VerticalAlignment="Center" Style="{StaticResource QuietButton}" />
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="Search" TextChanged="SearchChanged" AutomationProperties.Name="{x:Static local:UiStrings.SearchHint}" />
                <TextBlock Text="{x:Static local:UiStrings.SearchHint}" IsHitTestVisible="False" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </Grid>
            <Button Grid.Column="2" Content="{x:Static local:UiStrings.Refresh}" ToolTip="{x:Static local:UiStrings.RefreshTooltip}" Click="Refresh" MinWidth="88" />
        </Grid>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="18">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="{x:Static local:UiStrings.AvailableTitle}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{x:Static local:UiStrings.AvailableHint}" Style="{StaticResource MutedText}" /></StackPanel>
                    <Grid Grid.Row="1">
                        <ListBox x:Name="Processes" ItemTemplate="{StaticResource ProcessRow}" AutomationProperties.Name="{x:Static local:UiStrings.AvailableTitle}" />
                        <TextBlock Text="{x:Static local:UiStrings.EmptyAvailable}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="15" IsHitTestVisible="False">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=Processes}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <CheckBox x:Name="BlockCursorCheckBox" IsChecked="True" ToolTip="{x:Static local:UiStrings.BlockCursorTooltip}" Margin="0,0,0,12"><TextBlock Text="{x:Static local:UiStrings.BlockCursor}" TextWrapping="Wrap" /></CheckBox>
                        <Button Content="{x:Static local:UiStrings.Inject}" Click="Inject" ToolTip="{x:Static local:UiStrings.InjectTooltip}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding SelectedItem, ElementName=Processes}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="{x:Static local:UiStrings.ManagedTitle}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{x:Static local:UiStrings.ManagedHint}" Style="{StaticResource MutedText}" /></StackPanel>
                    <Grid Grid.Row="1">
                        <ListBox x:Name="InjectedProcesses" ItemTemplate="{StaticResource ProcessRow}" AutomationProperties.Name="{x:Static local:UiStrings.ManagedTitle}" />
                        <TextBlock Text="{x:Static local:UiStrings.EmptyManaged}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="15" IsHitTestVisible="False">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=InjectedProcesses}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Grid.Row="2" Content="{x:Static local:UiStrings.Unload}" Click="Unload" ToolTip="{x:Static local:UiStrings.UnloadTooltip}" Margin="0,16,0,0">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding SelectedItem, ElementName=InjectedProcesses}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="{DynamicResource RaisedBrush}" CornerRadius="10" Padding="14,11" Margin="0,18,0,0">
            <TextBlock Text="{x:Static local:UiStrings.SafetyNote}" Style="{StaticResource MutedText}" />
        </Border>
    </Grid>
</Window>
